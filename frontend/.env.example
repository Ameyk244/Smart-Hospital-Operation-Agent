# Base URL of the backend FastAPI server. Defaults to http://localhost:8000
# in src/api/client.ts if this is not set, so this file is optional for local
# dev with the default backend port.
VITE_API_BASE_URL=http://localhost:8000
# To send every browser request through the harness gateway instead (its opt-in
# front door, HOSPITAL_FRONT_DOOR=true), point this at the gateway:
# VITE_API_BASE_URL=http://localhost:8891
