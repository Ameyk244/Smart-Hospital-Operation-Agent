# Copy this file to .env and fill in real values. .env is gitignored.

# --- PostgreSQL (must match docker-compose.yml if you change it there) ---
POSTGRES_USER=hospital_admin
POSTGRES_PASSWORD=hospital_dev_password
POSTGRES_DB=hospital_ops
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Async SQLAlchemy connection string built from the above by default; override
# only if you need something different (e.g. a different host in CI).
DATABASE_URL=postgresql+asyncpg://hospital_admin:hospital_dev_password@localhost:5433/hospital_ops

# --- LLM provider ---
# One of: anthropic, openrouter
LLM_PROVIDER=anthropic

# Required if LLM_PROVIDER=anthropic. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Required if LLM_PROVIDER=openrouter. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# --- Bounded agent execution ---
MAX_AGENT_ROUNDS=6
MAX_TOOL_CALLS=10
TOOL_TIMEOUT_SECONDS=15
LLM_TIMEOUT_SECONDS=30
MAX_INVALID_TOOL_CALLS=3

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# Set to 1 to allow the live-model test suite to run (makes real API calls,
# costs real money). Left at 0 for the normal offline test run.
RUN_LIVE_LLM_TESTS=0
